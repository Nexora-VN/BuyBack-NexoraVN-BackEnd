generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["aff"]
}

// ==== START USERS ====
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
  @@schema("aff")
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED

  @@map("user_status")
  @@schema("aff")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  // User Information
  email        String  @unique @db.VarChar(320)
  phoneNumber  String  @unique @map("phone_number") @db.VarChar(20)
  passwordHash String  @map("password_hash")
  displayName  String? @map("display_name") @db.VarChar(120)
  fullName     String? @map("full_name") @db.VarChar(50)

  // Role - Status
  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  // Base Properties
  deleteAt DateTime? @map("delete_at") @db.Timestamptz(3)
  deleteBy String?   @map("delete_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  // Relationship
  // 1 User -> N UserBank
  banks                   UserBank[]
  sessions                AuthSession[]
  // 1 User -> N AffiliateLink
  affiliateLinks          AffiliateLink[]
  notebookImports         NotebookImport[]
  learnerCourseProgresses LearnerCourseProgress[]
  learnerPageProgresses   LearnerPageProgress[]
  activityAttempts        ActivityAttempt[]
  flashRuntimeSessions    FlashRuntimeSession[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
  @@schema("aff")
}

// ==== END USERS ====

// ==== START AUTH_SESSION ====
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
  @@schema("aff")
}

// ==== END AUTH_SESSION ====

// ==== START USER_BANK ====
enum UserBankStatus {
  PENDING
  APPROVED
  REJECT

  @@map("user_bank_status")
  @@schema("aff")
}

model UserBank {
  id String @id @default(uuid()) @db.Uuid

  //Bank infor
  bankCode   String         @map("bank_code") @db.VarChar(20)
  bankName   String?        @map("bank_name") @db.VarChar(100)
  bankBranch String?        @map("bank_branch") @db.VarChar(100)
  status     UserBankStatus @default(PENDING)

  // Base Properties
  deleteAt DateTime? @map("delete_at") @db.Timestamptz(3)
  deleteBy String?   @map("delete_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  // FK
  userId String @map("user_id") @db.Uuid
  // Relation N user_bank ->1 user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("user_bank")
  @@schema("aff")
}

// ==== END USER_BANK ====

// ==== START AFFILATE LINK ====
enum ConvertOrigin {
  SYSTEM
  PARTY

  @@map("convert_origin")
  @@schema("aff")
}

enum AffiliateLinkStatus {
  WORKING
  DELETED
  EXPIRED

  @@map("affiliate_link_status")
  @@schema("aff")
}

model AffiliateLink {
  id String @id @default(uuid()) @db.Uuid

  // SUB ID for validate USERID
  subId1 String? @map("sub_id_1") @db.VarChar(50) // User id
  subId2 String? @map("sub_id_2") @db.VarChar(50) // Affliate Link Id 
  subId3 String? @map("sub_id_3") @db.VarChar(50) // Channel (web, android, ios)
  subId4 String? @map("sub_id_4") @db.VarChar(50) // Tracking ID (`bb_{nanoId(20)}`)
  subId5 String? @map("sub_id_5") @db.VarChar(50) // Product ID

  // ORIGIN LINK: SHARE FROM SHOPEE
  originLink String @map("origin_link") @db.VarChar()
  // CLEAN LINK: After convert 
  // (exp: https://vn.shp.ee/NWRHsAhy -> https://shopee.vn/product/46182105/26771994719 -> ...105 is shopId, ...719 is productId)
  cleanLink  String @map("clean_link") @db.VarChar()

  // Link Convert Origin
  convertOrigin ConvertOrigin @default(SYSTEM) @map("convert_origin")

  // If Link convert by SYSTEM
  fullLinkSystem String? @map("full_link_system") @db.VarChar()

  // If Link convert by 3 PARTY 
  shortLink String? @map("short_link") @db.VarChar()
  longLink  String? @map("long_link") @db.VarChar()
  failCode  Int?    @map("fail_code") @db.Integer

  affiliateLinkStatus AffiliateLinkStatus? @map("affiliate_link_status")

  // Base Properties
  deleteAt DateTime? @map("delete_at") @db.Timestamptz(3)
  deleteBy String?   @map("delete_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  // FK 
  userId    String  @map("user_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  // N AffiliateLink -> 1 User
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // N AffiliateLink -> 1 Product
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([id, originLink])
  @@map("affiliate_link")
  @@schema("aff")
}

// ==== END AFFILATE LINK ====

// ==== START PRODUCT ====
model Product {
  id String @id @db.Uuid

  // ==== Start Product Information ====
  itemId BigInt @map("item_id") @db.BigInt
  shopId BigInt @map("shop_id") @db.BigInt

  productName String @map("product_name") @db.VarChar()
  shopName    String @map("shop_name") @db.VarChar()

  originLink String @map("origin_link") @db.VarChar()
  price      Float  @db.DoublePrecision
  sales      Float  @db.DoublePrecision

  imageUrl    String @map("image_url") @db.VarChar()
  productLink String @map("product_link") @db.VarChar()
  rating      String @db.VarChar(10)

  // ====> Start of COMMISSION 
  // WARNING: COMMISSION ==> CORE
  hasSellerCommission Boolean @map("has_seller_commission") @db.Boolean
  hasShopeeCommission Boolean @map("has_shopee_commission") @db.Boolean

  commission     Float @db.DoublePrecision
  sellerComFinal Float @map("seller_com_final") @db.DoublePrecision
  shoppeComFinal Float @map("shopee_com_final") @db.DoublePrecision

  sellerRate        Float @map("seller_rate") @db.DoublePrecision
  shopeeRate        Float @map("shopee_rate") @db.DoublePrecision
  sellerRatePercent Float @map("seller_rate_percent") @db.DoublePrecision
  shopeeRatePercent Float @map("shopee_rate_percent") @db.DoublePrecision
  totalRatePercent  Float @map("total_rate_percent") @db.DoublePrecision
  // <==== end of COMMISSION

  isExtra      Boolean @map("is_extra") @db.Boolean
  isCapped     Boolean @map("is_capped") @db.Boolean
  isLimitCap   Boolean @map("is_limit_cap") @db.Boolean
  cap          BigInt  @db.BigInt
  capRow       BigInt  @map("cap_row") @db.BigInt
  capAfterRate BigInt  @map("cap_after_rate") @db.BigInt

  lastUpdate DateTime @map("last_update") @db.Timestamptz(3)

  // Relationship
  priceStats         PriceStats?
  latestPriceHistory LatestPriceHistory?
  affilateLinks      AffiliateLink[]

  // ==== End Product Information ====

  @@map("product")
  @@schema("aff")
}

model PriceStats {
  id String @id @db.Uuid

  currentPrice Float @map("current_price") @db.DoublePrecision
  minPrice     Float @map("min_price") @db.DoublePrecision
  maxPrice     Float @map("max_price") @db.DoublePrecision
  avgPrice     Float @map("avg_price") @db.DoublePrecision

  priceChange7d  Float    @map("price_change_7d") @db.DoublePrecision
  priceChange30d Float    @map("price_change_30d") @db.DoublePrecision
  lastPriceUpate DateTime @map("last_price_update") @db.Timestamptz(3)

  lowestPriceDate  DateTime @map("lowest_price_date") @db.Timestamptz(3)
  highestPriceDate DateTime @map("highest_price_date") @db.Timestamptz(3)

  productId String  @unique @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_stats")
  @@schema("aff")
}

model LatestPriceHistory {
  id String @id @db.Uuid

  price           Float @db.DoublePrecision
  originalPrice   Float @map("original_price") @db.DoublePrecision
  discountPercent Float @map("discount_percent") @db.DoublePrecision

  currency  String  @default("VND") @db.VarChar(10)
  flashSale Boolean @db.Boolean

  recordedTime DateTime @map("recorded_time") @db.Timestamptz(3)

  productId String  @unique @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("latest_price_history")
  @@schema("aff")
}

// ==== END PRODUCT ====

enum NotebookImportStatus {
  QUEUED
  EXTRACTING
  ANALYZING
  PUBLISHING
  COMPLETED
  REQUIRES_REVIEW
  FAILED

  @@map("notebook_import_status")
  @@schema("aff")
}

enum ActivityStatus {
  UNMAPPED
  READY
  REQUIRES_REVIEW

  @@map("activity_status")
  @@schema("aff")
}

enum ActivityDefinitionStatus {
  DRAFT
  PUBLISHED

  @@map("activity_definition_status")
  @@schema("aff")
}

enum ActivityRendererMode {
  AUTO
  RUFFLE
  HTML
  DISABLED

  @@map("activity_renderer_mode")
  @@schema("aff")
}

enum FlashRuntimeStatus {
  UNTESTED
  LOADED
  PARTIAL
  FAILED

  @@map("flash_runtime_status")
  @@schema("aff")
}

model NotebookImport {
  id             String               @id @default(uuid()) @db.Uuid
  sourceFileName String               @map("source_file_name") @db.VarChar(255)
  sourceKey      String               @map("source_key") @db.VarChar(512)
  status         NotebookImportStatus @default(QUEUED)
  progress       Int                  @default(0)
  currentStep    String?              @map("current_step") @db.VarChar(255)
  report         Json?
  error          String?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?            @map("completed_at") @db.Timestamptz(3)

  createdById String  @map("created_by_id") @db.Uuid
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  course      Course?

  @@index([status, createdAt])
  @@map("notebook_imports")
  @@schema("aff")
}

model Course {
  id        String   @id @default(uuid()) @db.Uuid
  importId  String   @unique @map("import_id") @db.Uuid
  title     String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  outline   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  notebookImport    NotebookImport          @relation(fields: [importId], references: [id], onDelete: Cascade)
  pages             Page[]
  learnerProgresses LearnerCourseProgress[]

  @@map("courses")
  @@schema("aff")
}

model Page {
  id            String   @id @default(uuid()) @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  sourcePageId  String   @map("source_page_id") @db.VarChar(255)
  sortOrder     Int      @map("sort_order")
  width         Float
  height        Float
  contentUrl    String   @map("content_url") @db.VarChar(1024)
  navigation    Json
  audioHotspots Json     @map("audio_hotspots")
  interactions  Json?    @map("interactions")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  course            Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activities        Activity[]
  learnerProgresses LearnerPageProgress[]

  @@unique([courseId, sourcePageId])
  @@index([courseId, sortOrder])
  @@map("pages")
  @@schema("aff")
}

model ActivityDefinition {
  id          String                   @id @default(uuid()) @db.Uuid
  sourceHash  String                   @unique @map("source_hash") @db.VarChar(64)
  type        String                   @db.VarChar(100)
  version     Int                      @default(1)
  config      Json
  reviewedAt  DateTime                 @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  status      ActivityDefinitionStatus @default(DRAFT)
  rendererMode ActivityRendererMode    @default(AUTO) @map("renderer_mode")
  publishedAt DateTime?                @map("published_at") @db.Timestamptz(3)
  activities  Activity[]

  @@map("activity_definitions")
  @@schema("aff")
}

model FlashRuntimeProfile {
  sourceHash    String             @id @map("source_hash") @db.VarChar(64)
  storageKey    String             @map("storage_key") @db.VarChar(512)
  swfVersion    Int                @map("swf_version")
  status        FlashRuntimeStatus @default(UNTESTED)
  ruffleVersion String             @default("0.6.0") @map("ruffle_version") @db.VarChar(32)
  error         String?
  testedAt      DateTime?          @map("tested_at") @db.Timestamptz(3)
  errorCount    Int                @default(0) @map("error_count")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("flash_runtime_profiles")
  @@schema("aff")
}

model Activity {
  id            String         @id @default(uuid()) @db.Uuid
  pageId        String         @map("page_id") @db.Uuid
  sourceHash    String         @map("source_hash") @db.VarChar(64)
  sourcePath    String         @map("source_path") @db.VarChar(1024)
  candidateType String?        @map("candidate_type") @db.VarChar(100)
  confidence    Float          @default(0)
  status        ActivityStatus @default(UNMAPPED)
  bounds        Json
  definitionId  String?        @map("definition_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  page       Page                @relation(fields: [pageId], references: [id], onDelete: Cascade)
  definition ActivityDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  attempts   ActivityAttempt[]
  flashRuntimeSessions FlashRuntimeSession[]

  @@index([sourceHash])
  @@index([status])
  @@map("activities")
  @@schema("aff")
}

model FlashRuntimeSession {
  id             String   @id @default(uuid()) @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  nonce          String   @unique @db.VarChar(64)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  openedAt       DateTime? @map("opened_at") @db.Timestamptz(3)
  loadedAt       DateTime? @map("loaded_at") @db.Timestamptz(3)
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz(3)
  activeSeconds  Int      @default(0) @map("active_seconds")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activityId, createdAt])
  @@map("flash_runtime_sessions")
  @@schema("aff")
}

model LearnerCourseProgress {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  lastPageId    String?  @map("last_page_id") @db.VarChar(255)
  viewedPageIds Json     @map("viewed_page_ids")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("learner_course_progresses")
  @@schema("aff")
}

model LearnerPageProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  pageId      String    @map("page_id") @db.Uuid
  viewedAt    DateTime  @default(now()) @map("viewed_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@map("learner_page_progresses")
  @@schema("aff")
}

model ActivityAttempt {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  activityId        String    @map("activity_id") @db.Uuid
  definitionVersion Int       @map("definition_version")
  result            Json
  score             Float     @default(0)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId, activityId, createdAt])
  @@map("activity_attempts")
  @@schema("aff")
}
