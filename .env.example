NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=aff
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=buyback-api
JWT_AUDIENCE=buyback-client
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
LOG_LEVEL=info

# One platform affiliate account. Required for generating links.
SHOPEE_AFFILIATE_ID=17303170528
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep a secure backup: losing this key makes bank details/cookie unrecoverable.
FINANCE_ENCRYPTION_KEY=
# Rollout gates: manual sync remains available when scheduled reconciliation is off.
RECONCILIATION_ENABLED=false
SETTLEMENT_ENABLED=false
WITHDRAWALS_ENABLED=false
